# Copy to .env to override the defaults in docker-compose.yml.
# These are local development values only.

MYSQL_ROOT_PASSWORD=root_local_only
MYSQL_DATABASE=duckstore
MYSQL_TEST_DATABASE=duckstore_test
MYSQL_USER=duck
MYSQL_PASSWORD=duck_local_only

# Host port MySQL is published on. 3307 avoids clashing with a local MySQL.
MYSQL_PORT=3307
